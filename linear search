#include <stdio.h>

int main() {
    int arr[] = {12, 45, 78, 23, 56};
    int n = 5;
    int target = 23;
    int index = -1;

    for (int i = 0; i < n; i++) {
        if (arr[i] == target) {
            index = i;
            break;
        }
    }

    if (index != -1) {
        printf("Element found at index: %d\n", index);
    } else {
        printf("Element not found\n");
    }

    return 0;
}
